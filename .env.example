# Copy the entries you need into your local environment. Do not commit real values.

# Discord / Slack webhooks
DISCORD_WEBHOOK_URL=
SLACK_WEBHOOK_URL=

# Legacy LINE Notify support (prefer Discord, Slack, or email for new setups)
LINE_NOTIFY_TOKEN=

# Email notification (set EMAIL_ENABLED=true to enable)
EMAIL_ENABLED=false
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_FROM=
EMAIL_TO=
EMAIL_APP_PASSWORD=

# Set to true only when checking a configured notification channel.
TEST_NOTIFY=false
